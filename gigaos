static String rtcTime() {
    char buf[16];
    tm t;
    _rtc_localtime(time(NULL), &t, RTC_4_YEAR_LEAP_YEAR_SUPPORT);
    strftime(buf, sizeof(buf), "%I:%M:%S %p", &t);
    return String(buf);
}

static String rtcDateTime() {
    char buf[32];
    tm t;
    _rtc_localtime(time(NULL), &t, RTC_4_YEAR_LEAP_YEAR_SUPPORT);
    strftime(buf, sizeof(buf), "%Y-%m-%d %I:%M:%S %p", &t);
    return String(buf);
}

static String fmtUptime(uint64_t us) {
    uint32_t sec = (uint32_t)(us / 1000000ULL);
    char buf[16];
    snprintf(buf, sizeof(buf), "%02lu:%02lu:%02lu",
             sec / 3600, (sec % 3600) / 60, sec % 60);
    return String(buf);
}

// Convenience overload using millis() when no mbed_stats_cpu_t is available
static String fmtUptime() {
    return fmtUptime((uint64_t)millis() * 1000ULL);
}

// ================================================================
// HELPERS -- NTP
// ================================================================
static const int NTP_PKT_SZ = 48;
static byte      ntpBuf[NTP_PKT_SZ];
static WiFiUDP   ntpUdp;

static void ntpSend(const char* host) {
    memset(ntpBuf, 0, NTP_PKT_SZ);
    ntpBuf[0]  = 0b11100011;  // LI, Version, Mode
    ntpBuf[1]  = 0; ntpBuf[2] = 6; ntpBuf[3] = 0xEC;
    ntpBuf[12] = 49; ntpBuf[13] = 0x4E;
    ntpBuf[14] = 49; ntpBuf[15] = 52;
    ntpUdp.beginPacket(host, 123);
    ntpUdp.write(ntpBuf, NTP_PKT_SZ);
    ntpUdp.endPacket();
}

static bool ntpSync() {
    if (WiFi.status() != WL_CONNECTED) return false;
    ntpUdp.begin(NTP_LOCAL_PORT);
    ntpSend(NTP_SERVER);
    delay(1500);
    if (!ntpUdp.parsePacket()) return false;
    ntpUdp.read(ntpBuf, NTP_PKT_SZ);
    unsigned long hi  = word(ntpBuf[40], ntpBuf[41]);
    unsigned long lo  = word(ntpBuf[42], ntpBuf[43]);
    unsigned long ep  = (hi << 16 | lo) - 2208988800UL;
    ep += (unsigned long)((long)TIMEZONE_HOURS * 3600L);
    set_time(ep);
    gNtpSynced = true;
    return true;
}

// ================================================================
// HELPERS -- Levenshtein distance (fuzzy command matching)
// Returns edit distance between two short strings (max len 23).
// ================================================================
static int levenshtein(const char* a, const char* b) {
    static int dp[24][24];
    int la = strlen(a), lb = strlen(b);
    if (la >= 24 || lb >= 24) return 99;
    for (int i = 0; i <= la; i++) dp[i][0] = i;
    for (int j = 0; j <= lb; j++) dp[0][j] = j;
    for (int i = 1; i <= la; i++)
        for (int j = 1; j <= lb; j++) {
            int c = (tolower((unsigned char)a[i-1]) ==
                     tolower((unsigned char)b[j-1])) ? 0 : 1;
            dp[i][j] = min(min(dp[i-1][j] + 1, dp[i][j-1] + 1),
                               dp[i-1][j-1] + c);
        }
    return dp[la][lb];
}

static const char* closestCmd(const char* input) {
    int best = 99;
    const char* name = nullptr;
    for (int i = 0; i < CMD_COUNT; i++) {
        int d = levenshtein(input, commands[i].name);
        if (d < best) { best = d; name = commands[i].name; }
    }
    return (best <= 3) ? name : nullptr;
}

// ================================================================
// TERMINAL -- add a line to the scrollback buffer
// Thread-safe. Wraps long lines automatically.
// ================================================================
// helper: add one pre-measured line to the buffer
static void termAddLine(const char* text, int len, uint16_t color) {
    if (termCount >= TERM_ROWS_VIS) termVisScroll = true;
    int slot;
    if (termCount < TERM_SCROLLBACK) { slot = termCount++; }
    else {
        memmove(termBuf, termBuf + 1, sizeof(TermLine) * (TERM_SCROLLBACK - 1));
        slot = TERM_SCROLLBACK - 1;
    }
    if (len > 0) memcpy(termBuf[slot].text, text, len);
    termBuf[slot].text[len] = '\0';
    termBuf[slot].color = color;
}

static void termPrint(const char* text, uint16_t color = COL_TEXT) {
    // Mirror to Serial if a serial client is connected
    if (gSerialActive) Serial.println(text);
    termMtx.lock();
    int len = strlen(text);
    const int limit = TERM_COLS - 1;

    if (len == 0) {
        termAddLine("", 0, color);
        termDirty = true;
        termMtx.unlock();
        return;
    }
    int pos = 0;
    while (pos < len) {
        int remaining = len - pos;
        if (remaining <= limit) {
            termAddLine(text + pos, remaining, color);
            break;
        }
        // Word-aware: search backward from limit for a space
        int brk = limit;
        for (int i = limit; i > 0; i--) {
            if (text[pos + i] == ' ') { brk = i; break; }
        }
        termAddLine(text + pos, brk, color);
        pos += brk;
        if (pos < len && text[pos] == ' ') pos++;
    }
    termDirty = true;
    termMtx.unlock();
}

// Convenience overloads
static void termPrint(String s, uint16_t color = COL_TEXT) {
    termPrint(s.c_str(), color);
}

// Printf-style terminal output
static void termPrintf(uint16_t color, const char* fmt, ...) {
    char buf[TERM_LINE_LEN];
    va_list v;
    va_start(v, fmt);
    vsnprintf(buf, sizeof(buf), fmt, v);
    va_end(v);
    termPrint(buf, color);
}

// ================================================================
// RENDERER -- top bar
// Called from statsTask every 1s; uses dispMtx for thread safety.
// ================================================================
static void drawTopBar() {
    dispMtx.lock();

    // Background + separator
    display.fillRect(0, 0, DISP_W, TOPBAR_H, COL_TOPBAR);
    display.drawFastHLine(0, TOPBAR_SEP_Y, DISP_W, COL_TOPBAR_SEP);
    display.setTextSize(TOPBAR_FONT_SZ);
    display.setTextColor(COL_TOPBAR_TXT);

    int ty = (TOPBAR_H - TOPBAR_CH) / 2;

    // LEFT -- cpu% (last 1s) + die temp in F, monospace width
    statMtx.lock();
    float busy = gBusy1s;
    float temp = gTempF;
    statMtx.unlock();

    char left[32];
    if (temp < 0.0f)
        snprintf(left, sizeof(left), "CPU:%3.0f%%  ---F", busy);
    else
        snprintf(left, sizeof(left), "CPU:%3.0f%%  %5.1fF", busy, temp);
    display.setCursor(4, ty);
    display.print(left);

    // CENTER -- current time
    String ts = rtcTime();
    int    tw = ts.length() * 6;    // 6px per char at textSize(1)
    display.setCursor((DISP_W - tw) / 2, ty);
    display.print(ts);

    // RIGHT -- spinner when working, SSID when connected+idle, blank otherwise
    bool working = gWifiConnecting || gPingRunning;
    char right[32] = "";
    if (working) {
        gSpinnerFrame = (gSpinnerFrame + 1) % 4;
        snprintf(right, sizeof(right), "Working %c", kSpin[gSpinnerFrame]);
    } else if (gWifiConnected) {
        snprintf(right, sizeof(right), "%.22s", WiFi.SSID());
    }
    if (right[0]) {
        int rw = strlen(right) * 6 * TOPBAR_FONT_SZ;
        display.setCursor(DISP_W - rw - 4, ty);
        display.print(right);
    }

    dispMtx.unlock();
}

// ================================================================
// RENDERER -- full terminal area redraw
// Only runs when termDirty == true.
// ================================================================
static void drawTerminal() {
    if (!termDirty) return;

    dispMtx.lock();
    display.setTextSize(TERM_FONT_SZ);

    termMtx.lock();

    // Decide: full redraw or incremental append
    bool doFull = termVisScroll || termWasCleared ||
                  (termCount < lastRenderedCount) ||
                  (lastRenderedCount == 0 && termCount > 0);
    termVisScroll  = false;
    termWasCleared = false;

    if (doFull) {
        // Full redraw -- clear everything and repaint all visible lines
        display.fillRect(0, TERM_Y, DISP_W, TERM_H, COL_BG);
        int first = max(0, termCount - TERM_ROWS_VIS);
        int count = termCount - first;
        for (int i = 0; i < count; i++) {
            display.setCursor(0, TERM_Y + i * TERM_CH);
            display.setTextColor(termBuf[first + i].color);
            display.print(termBuf[first + i].text);
        }
    } else {
        // Incremental -- only paint lines added since last render
        // (safe when termCount <= TERM_ROWS_VIS, no visual scrolling)
        for (int i = lastRenderedCount; i < termCount && i < TERM_ROWS_VIS; i++) {
            int y = TERM_Y + i * TERM_CH;
            display.fillRect(0, y, DISP_W, TERM_CH, COL_BG);
            display.setCursor(0, y);
            display.setTextColor(termBuf[i].color);
            display.print(termBuf[i].text);
        }
    }

    lastRenderedCount = termCount;
    termMtx.unlock();

    // Always redraw input row (mode-aware prompt + password masking)
    int iy = TERM_Y + TERM_ROWS_VIS * TERM_CH;
    const char* prompt = currentPrompt();
