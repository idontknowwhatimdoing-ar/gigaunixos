// ================================================================
// COMMANDS -- threads
// ================================================================
void cmd_threads(String args) {
    // Use CMSIS-RTOS2 osThreadEnumerate to get thread IDs and names.
    // mbed_stats_thread_t has no name field; osThreadGetName() does.
    const int MAX_T = 32;
    osThreadId_t tids[MAX_T];
    uint32_t cnt = osThreadEnumerate(tids, MAX_T);

    if (cnt == 0) { termPrint("threads: no data.", COL_DIM); return; }

    static const char* stNames[] = {
        "Inactive", "Ready", "Running", "Blocked", "Terminated", "Error"
    };
    auto stateName = [&](osThreadState_t s) -> const char* {
        switch(s) {
            case osThreadInactive:   return "Inactive";
            case osThreadReady:      return "Ready";
            case osThreadRunning:    return "Running";
            case osThreadBlocked:    return "Blocked";
            case osThreadTerminated: return "Terminated";
            case osThreadError:      return "Error";
            default:                 return "?";
        }
    };

    termPrint("-- RTOS Threads ------------------------------------------------", COL_INFO);
    termPrint("  NAME                           STATE       PRIO  FREE STK", COL_DIM);
    termPrint("  -------------------------------------------------------------", COL_DIM);

    for (uint32_t i = 0; i < cnt; i++) {
        const char*    name  = osThreadGetName(tids[i]);
        osThreadState_t state = osThreadGetState(tids[i]);
        osPriority_t   prio  = osThreadGetPriority(tids[i]);
        uint32_t       free  = osThreadGetStackSpace(tids[i]);

        char buf[TERM_LINE_LEN];
        snprintf(buf, sizeof(buf), "  %-30s %-11s %3d   %5luB",
                 name ? name : "(unnamed)",
                 stateName(state),
                 (int)prio,
                 free);
        // highlight GigaOS and GBasic threads differently
        uint16_t col = COL_TEXT;
        if (name && strncmp(name, "GBasic", 6) == 0) col = COL_INFO;
        termPrint(buf, col);
    }

    termPrint("  -------------------------------------------------------------", COL_DIM);
    termPrintf(COL_DIM, "  %lu threads total  |  PRIO: higher number = higher priority", cnt);
    termPrint("", COL_TEXT);
}

// ================================================================
// COMMANDS -- units converter
// ================================================================
void cmd_units(String args) {
    args.trim();
    int sp1=args.indexOf(' ');
    if (sp1==-1){
        termPrint("Error: units <value> <from> <to>",COL_ERROR);
        termPrint("  e.g.: units 72 F C  |  units 100 km mi  |  units 5 kg lb",COL_DIM);
        return;
    }
    float val=args.substring(0,sp1).toFloat();
    String rest=args.substring(sp1+1); rest.trim();
    int sp2=rest.indexOf(' ');
    if (sp2==-1){termPrint("Error: missing 'to' unit.",COL_ERROR);return;}
    String fr=rest.substring(0,sp2); fr.toLowerCase();
    String to=rest.substring(sp2+1); to.trim(); to.toLowerCase();
    float res; bool ok=true;
    // Temperature
    if      ((fr=="f"||fr=="fahrenheit")&&(to=="c"||to=="celsius"))  res=(val-32)*5.0f/9.0f;
    else if ((fr=="c"||fr=="celsius")&&(to=="f"||to=="fahrenheit"))  res=val*9.0f/5.0f+32;
    else if ((fr=="c"||fr=="celsius")&&to=="k")                      res=val+273.15f;
    else if (fr=="k"&&(to=="c"||to=="celsius"))                      res=val-273.15f;
    else if ((fr=="f"||fr=="fahrenheit")&&to=="k")                   res=(val-32)*5.0f/9.0f+273.15f;
    else if (fr=="k"&&(to=="f"||to=="fahrenheit"))                   res=(val-273.15f)*9.0f/5.0f+32;
    // Distance
    else if (fr=="km"&&(to=="mi"||to=="miles"))   res=val*0.621371f;
    else if ((fr=="mi"||fr=="miles")&&to=="km")   res=val*1.60934f;
    else if (fr=="m"&&(to=="ft"||to=="feet"))     res=val*3.28084f;
    else if ((fr=="ft"||fr=="feet")&&to=="m")     res=val*0.3048f;
    else if (fr=="cm"&&(to=="in"||to=="inches"))  res=val*0.393701f;
    else if ((fr=="in"||fr=="inches")&&to=="cm")  res=val*2.54f;
    else if (fr=="mm"&&to=="in")  res=val*0.0393701f;
    else if (fr=="in"&&to=="mm")  res=val*25.4f;
    // Weight
    else if (fr=="kg"&&(to=="lb"||to=="lbs"))     res=val*2.20462f;
    else if ((fr=="lb"||fr=="lbs")&&to=="kg")     res=val*0.453592f;
    else if (fr=="g"&&(to=="oz"||to=="ounces"))   res=val*0.035274f;
    else if ((fr=="oz"||fr=="ounces")&&to=="g")   res=val*28.3495f;
    // Speed
    else if ((fr=="kmh"||fr=="km/h")&&(to=="mph"||to=="mi/h")) res=val*0.621371f;
    else if ((fr=="mph"||fr=="mi/h")&&(to=="kmh"||to=="km/h")) res=val*1.60934f;
    else if (fr=="m/s"&&(to=="kmh"||to=="km/h")) res=val*3.6f;
    else if ((fr=="kmh"||fr=="km/h")&&to=="m/s") res=val/3.6f;
    else if (fr=="m/s"&&(to=="mph"||to=="mi/h")) res=val*2.23694f;
    else if ((fr=="mph"||fr=="mi/h")&&to=="m/s") res=val*0.44704f;
    // Time
    else if (fr=="s"&&to=="ms")  res=val*1000;
    else if (fr=="ms"&&to=="s")  res=val/1000;
    else if (fr=="s"&&to=="min") res=val/60;
    else if (fr=="min"&&to=="s") res=val*60;
    else if (fr=="min"&&to=="h") res=val/60;
    else if (fr=="h"&&to=="min") res=val*60;
    else if (fr=="s"&&to=="h")   res=val/3600;
    else if (fr=="h"&&to=="s")   res=val*3600;
    // Data
    else if (fr=="b"&&to=="kb")  res=val/1024;
    else if (fr=="kb"&&to=="mb") res=val/1024;
    else if (fr=="mb"&&to=="gb") res=val/1024;
    else if (fr=="gb"&&to=="mb") res=val*1024;
    else if (fr=="mb"&&to=="kb") res=val*1024;
    else if (fr=="kb"&&to=="b")  res=val*1024;
    else { ok=false; }
    if (!ok){
        termPrintf(COL_ERROR,"units: unknown: %s to %s",fr.c_str(),to.c_str());
        termPrint("  Supported: F/C/K  km/mi  m/ft  cm/in  mm/in",COL_DIM);
        termPrint("             kg/lb  g/oz  kmh/mph  m/s  s/ms/min/h  B/KB/MB/GB",COL_DIM);
        return;
    }
    char buf[TERM_LINE_LEN];
    if (res==floor(res)&&fabs(res)<1e9)
        snprintf(buf,sizeof(buf),"%g %s = %.0f %s",val,fr.c_str(),res,to.c_str());
    else
        snprintf(buf,sizeof(buf),"%g %s = %g %s",val,fr.c_str(),res,to.c_str());
    termPrint(buf,COL_INFO);
}

// ================================================================
// COMMANDS -- hex, bin (both accept any base, show all three)
// ================================================================
static long parseAnyBase(const char* s) {
    if (!s||!*s) return 0;
    if (s[0]=='0'&&(s[1]=='x'||s[1]=='X')) return strtol(s+2,nullptr,16);
    if (s[0]=='0'&&(s[1]=='b'||s[1]=='B')) return strtol(s+2,nullptr,2);
    return strtol(s,nullptr,10);
}
static void printAllBases(long val, uint16_t color) {
    uint32_t uval=(uint32_t)val;
    char binBuf[36]="0b";
    if (uval==0){ strncat(binBuf,"0",sizeof(binBuf)-3); }
    else {
        char tmp[33]={};
        int start=31;
        while(start>0&&!((uval>>start)&1)) start--;
        for(int i=start;i>=0;i--) tmp[start-i]=((uval>>i)&1)?'1':'0';
        tmp[start+1]='\0';
        strncat(binBuf,tmp,sizeof(binBuf)-3);
    }
    char buf[TERM_LINE_LEN];
    if(val<0) snprintf(buf,sizeof(buf),"%ld  =  0x%08lX  =  %s  (signed)",val,(unsigned long)val,binBuf);
    else      snprintf(buf,sizeof(buf),"%ld  =  0x%lX  =  %s",val,(unsigned long)val,binBuf);
    termPrint(buf,color);
}
void cmd_hex(String args) {
    args.trim();
    if (args.length()==0){termPrint("Error: provide a number.",COL_ERROR);return;}
    printAllBases(parseAnyBase(args.c_str()),COL_INFO);
}
void cmd_bin(String args) {
    args.trim();
    if (args.length()==0){termPrint("Error: provide a number.",COL_ERROR);return;}
    printAllBases(parseAnyBase(args.c_str()),COL_INFO);
}

// ================================================================
// COMMANDS -- i2c
// ================================================================
void cmd_i2c(String args) {
    args.trim();
    if (args.startsWith("scan")) {
        Wire.begin();
        termPrint("Scanning I2C bus (0x01-0x7F)...",COL_INFO);
        int found=0;
        for (uint8_t addr=1;addr<=127;addr++){
            Wire.beginTransmission(addr);
            if (Wire.endTransmission()==0){ termPrintf(COL_TEXT,"  Device at 0x%02X",addr); found++; }
            delay(2);
        }
        termPrintf(found>0?COL_INFO:COL_DIM,"Scan complete -- %d device(s) found.",found);
        return;
    }
    if (args.startsWith("read ")) {
        String rest=args.substring(5); rest.trim();
        int sp1=rest.indexOf(' ');
        String addrStr=(sp1==-1)?rest:rest.substring(0,sp1);
        int addr=(int)strtol(addrStr.c_str(),nullptr,0);
        if (addr<=0||addr>127){termPrint("Error: address must be 0x01-0x7F.",COL_ERROR);return;}
        int reg=-1,count=1;
        if (sp1!=-1){
            String rest2=rest.substring(sp1+1); rest2.trim();
            int sp2=rest2.indexOf(' ');
            String regStr=(sp2==-1)?rest2:rest2.substring(0,sp2);
            reg=(int)strtol(regStr.c_str(),nullptr,0);
            if(sp2!=-1){count=rest2.substring(sp2+1).toInt();if(count<=0)count=1;if(count>32)count=32;}
        }
        Wire.begin();
        if (reg>=0){
            Wire.beginTransmission((uint8_t)addr);
            Wire.write((uint8_t)reg);
            if(Wire.endTransmission(false)!=0){termPrintf(COL_ERROR,"i2c: no ACK from 0x%02X",addr);return;}
        }
        uint8_t rcvd=Wire.requestFrom((uint8_t)addr,(uint8_t)count);
        if(rcvd==0){termPrintf(COL_ERROR,"i2c: no response from 0x%02X",addr);return;}
        char line[TERM_LINE_LEN]="";
        char prefix[24];
        if(reg>=0) snprintf(prefix,sizeof(prefix),"0x%02X[0x%02X]: ",addr,reg);
        else       snprintf(prefix,sizeof(prefix),"0x%02X: ",addr);
        strncat(line,prefix,sizeof(line)-1);
        while(Wire.available()){
            char bs[6]; snprintf(bs,sizeof(bs),"0x%02X ",(uint8_t)Wire.read());
            int rem=sizeof(line)-strlen(line)-1; if(rem>5)strncat(line,bs,rem);
        }
        termPrint(line,COL_TEXT);
        return;
    }
    termPrint("Error: unknown i2c subcommand.",COL_ERROR);
    termPrint("       i2c scan",COL_DIM);
    termPrint("       i2c read <addr_hex> [reg_hex] [byte_count]",COL_DIM);
}

// ================================================================
// COMMANDS -- gpio
// ================================================================
void cmd_gpio(String args) {
    args.trim();
    int sp=args.indexOf(' ');
    if (sp==-1){
        termPrint("Error: missing pin.",COL_ERROR);
        termPrint("  gpio <pin> read",COL_DIM);
        termPrint("  gpio <pin> write <high|low>",COL_DIM);
        termPrint("  gpio <pin> mode <input|output|input_pullup>",COL_DIM);
        termPrint("  gpio <pin> adc   (16-bit analog read, ref 3.3V)",COL_DIM);
        termPrint("  GIGA is 3.3V -- do NOT apply 5V to any pin!",COL_DIM);
        return;
    }
    int pin=args.substring(0,sp).toInt();
    String sub=args.substring(sp+1); sub.trim();
    if (sub=="read"){
        pinMode(pin,INPUT);
        termPrintf(COL_INFO,"D%-2d = %s",pin,digitalRead(pin)?"HIGH":"LOW");
    } else if (sub=="high"||sub=="write high"||sub=="write 1"){
        pinMode(pin,OUTPUT); digitalWrite(pin,HIGH);
        termPrintf(COL_INFO,"D%-2d -> HIGH",pin);
    } else if (sub=="low"||sub=="write low"||sub=="write 0"){
        pinMode(pin,OUTPUT); digitalWrite(pin,LOW);
        termPrintf(COL_INFO,"D%-2d -> LOW",pin);
    } else if (sub.startsWith("write ")){
        String v=sub.substring(6); v.trim();
        if(v=="high"||v=="1"){pinMode(pin,OUTPUT);digitalWrite(pin,HIGH);termPrintf(COL_INFO,"D%-2d -> HIGH",pin);}
        else if(v=="low"||v=="0"){pinMode(pin,OUTPUT);digitalWrite(pin,LOW);termPrintf(COL_INFO,"D%-2d -> LOW",pin);}
        else termPrint("Error: write value must be high/low/0/1.",COL_ERROR);
    } else if (sub=="adc"){
        analogReadResolution(16);
        int raw=analogRead(pin);
        termPrintf(COL_INFO,"A%-2d = %5d  (%.3f V)",pin,raw,raw*3.3f/65535.0f);
    } else if (sub.startsWith("mode ")){
        String m=sub.substring(5); m.trim();
        if      (m=="input")       {pinMode(pin,INPUT);       termPrintf(COL_INFO,"D%-2d -> INPUT",pin);}
        else if (m=="output")      {pinMode(pin,OUTPUT);      termPrintf(COL_INFO,"D%-2d -> OUTPUT",pin);}
        else if (m=="input_pullup"){pinMode(pin,INPUT_PULLUP);termPrintf(COL_INFO,"D%-2d -> INPUT_PULLUP",pin);}
        else termPrint("Error: mode must be input, output, or input_pullup.",COL_ERROR);
    } else {
        termPrintf(COL_ERROR,"Error: unknown gpio subcommand '%s'",sub.c_str());
        termPrint("       gpio <pin> read | write <high|low> | mode <...> | adc",COL_DIM);
    }
}

void cmd_sysinfo(String args) {
    mbed_stats_sys_t sys;
    mbed_stats_sys_get(&sys);

    // Decode compiler ID to a human name
    const char* compName;
    switch (sys.compiler_id) {
        case 1:  compName = "ARM Compiler 5"; break;
        case 2:  compName = "ARM Compiler 6"; break;
        case 3:  compName = "GCC ARM";        break;
        case 4:  compName = "IAR";            break;
        default: compName = "Unknown";        break;
    }

    // Decode compiler version -- encoded as Mmmmpppp (major, minor, patch)
    uint32_t cv    = sys.compiler_version;
    uint32_t cmaj  = cv / 1000000;
    uint32_t cmin  = (cv % 1000000) / 1000;
    uint32_t cpat  = cv % 1000;

    // Decode mbed OS version -- encoded as Mmmpppp
    uint32_t ov    = sys.os_version;
    uint32_t omaj  = ov / 10000;
    uint32_t omin  = (ov % 10000) / 100;
    uint32_t opat  = ov % 100;

    termPrint("-- System Information -------------------", COL_INFO);

    // OS + compiler
    termPrintf(COL_TEXT, "  mbed OS version:  %lu.%lu.%lu  (raw: %lu)",
               omaj, omin, opat, ov);
    termPrintf(COL_TEXT, "  Compiler:         %s", compName);
    termPrintf(COL_TEXT, "  Compiler version: %lu.%lu.%lu  (raw: %lu)",
               cmaj, cmin, cpat, cv);
    termPrintf(COL_TEXT, "  CPU ID register:  0x%08lX", sys.cpu_id);

    // RAM regions
    termPrint("  RAM regions:", COL_DIM);
    for (int i = 0; i < MBED_MAX_MEM_REGIONS; i++) {
        if (sys.ram_size[i] == 0) continue;
        termPrintf(COL_TEXT, "    [%d] start: 0x%08lX  size: %lu bytes (%lu KB)",
                   i,
                   sys.ram_start[i],
                   sys.ram_size[i],
                   sys.ram_size[i] / 1024);
    }

    // ROM regions
    termPrint("  ROM regions:", COL_DIM);
    for (int i = 0; i < MBED_MAX_MEM_REGIONS; i++) {
        if (sys.rom_size[i] == 0) continue;
        termPrintf(COL_TEXT, "    [%d] start: 0x%08lX  size: %lu bytes (%lu KB)",
                   i,
                   sys.rom_start[i],
                   sys.rom_size[i],
                   sys.rom_size[i] / 1024);
    }

    // Heap
    mbed_stats_heap_t heap;
    mbed_stats_heap_get(&heap);
    termPrint("  Heap:", COL_DIM);
    if (heap.reserved_size > 0) {
        termPrintf(COL_TEXT, "    used %lu KB / %lu KB  (%u%%)",
                   heap.current_size / 1024,
                   heap.reserved_size / 1024,
                   (uint8_t)((heap.current_size * 100UL) / heap.reserved_size));
    } else {
        termPrint("    (unavailable)", COL_DIM);
    }

    termPrint("-----------------------------------------", COL_DIM);
}

// ================================================================
// BACKGROUND TASK -- WiFi
// Runs at low priority. Waits for signals from cmd_wifi.
// Never blocks the main UI thread.
// ================================================================
static void wifiTaskFn() {
    while (true) {
        uint32_t flags = wifiEvt.wait_any(WIFIEVT_CONNECT | WIFIEVT_DISCONNECT);

        if (flags & WIFIEVT_DISCONNECT) {
            WiFi.disconnect();
            gWifiConnected  = false;
            gWifiConnecting = false;
            termPrint("WiFi: disconnected.", COL_INFO);
            termDirty = true;
        }

        if (flags & WIFIEVT_CONNECT) {
            WiFi.begin(gWifiSSID, gWifiPass);
            int tries = 0;
            while (WiFi.status() != WL_CONNECTED && tries < 30) {
                rtos::ThisThread::sleep_for(1000);
                tries++;
            }
            if (WiFi.status() == WL_CONNECTED) {
                gWifiConnected  = true;
                gWifiConnecting = false;
                IPAddress ip = WiFi.localIP();
                termPrintf(COL_INFO, "WiFi connected! IP: %d.%d.%d.%d",
                           ip[0], ip[1], ip[2], ip[3]);
            } else {
                gWifiConnected  = false;
                gWifiConnecting = false;
                int wst = WiFi.status();
                if      (wst == WL_CONNECT_FAILED) termPrint("WiFi: wrong password.", COL_ERROR);
                else if (wst == WL_NO_SSID_AVAIL)  termPrintf(COL_ERROR, "WiFi: SSID '%s' not found.", gWifiSSID);
                else                               termPrintf(COL_ERROR, "WiFi: connection failed (status %d).", wst);
            }
            termDirty = true;
        }
    }
}

// ================================================================
// BACKGROUND TASK -- CPU stats (every 1 second)
// Uses mbed_stats_cpu_get() -- confirmed working on GIGA R1.
// MBED_ALL_STATS_ENABLED=1 is compiled into libmbed.a for this variant.
// Measures all-thread idle time (not just main thread).
// Runs at below-normal priority so it never starves the UI.
// ================================================================
static void statsTaskFn() {
    while (true) {
        rtos::ThisThread::sleep_for(1000);

        mbed_stats_cpu_t cpu;
        mbed_stats_cpu_get(&cpu);

        uint64_t idleDelta = cpu.idle_time - gPrevIdle;
        uint64_t upDelta   = cpu.uptime    - gPrevUp;

        statMtx.lock();
        if (upDelta > 0)
            gBusy1s = 100.0f - (float)((idleDelta * 100ULL) / upDelta);
        gTempF = readTempF();
        statMtx.unlock();

        gPrevIdle = cpu.idle_time;
        gPrevUp   = cpu.uptime;
    }
}

// gbasic.h must be included AFTER global objects so its functions
// can see display, keyb, dispMtx etc. (all declared above this line)
#include "gbasic.h"

// ================================================================
// SETUP
// ================================================================
void setup() {
    Serial.begin(115200);

    // Enable USB-A port for keyboard -- required before keyb.begin()
    pinMode(PA_15, OUTPUT);
    digitalWrite(PA_15, HIGH);

    // Init SDRAM (available to apps via SDRAM.malloc())
    SDRAM.begin();

    // Init GBasic temp filesystem and var region in SDRAM
    gbInit();

    // Init display -- setRotation(1) forces landscape (800x480)
    display.begin();
    display.setRotation(1);
    display.fillScreen(COL_BG);

    // Init keyboard
    keyb.begin();

    // Clear input buffer
    memset(inputBuf, 0, sizeof(inputBuf));

    // Initial render
    drawTopBar();
    drawTerminal();

    // Boot banner
    termPrint("",                                                      COL_TEXT);
    termPrint("  GigaOS v1.0 beta",                                   COL_INFO);
    termPrint("  Arduino GIGA R1 WiFi  |  STM32H747XI  |  M7@480MHz", COL_DIM);
    termPrint("  1MB SRAM + 8MB SDRAM  |  mbed OS",                   COL_DIM);
    char cmdCountBuf[48];
    snprintf(cmdCountBuf, sizeof(cmdCountBuf),
             "  %d commands loaded", CMD_COUNT);
    termPrint(cmdCountBuf,                                             COL_DIM);
    termPrint("",                                                      COL_TEXT);
    termPrint("  Type 'help' to list commands.",                       COL_TEXT);
    termPrint("  Type 'rtc set HH:MM:SS DD/MM/YYYY' to set the clock.",COL_DIM);
    termPrint("",                                                      COL_TEXT);

    // Start background threads
    // Stats task: below normal so UI is never starved
    statsTask.start(statsTaskFn);

    // WiFi task: low priority, only runs when signaled
    wifiTask.start(wifiTaskFn);

    // Ping task: low priority, runs when signaled by cmd_ping
    pingTask.start(pingTaskFn);

    // GBasic scheduler: checks RTC every minute for scheduled scripts
    gbasicSched.start(gbSchedulerTaskFn);

    termDirty = true;
}

// ================================================================
// LOOP -- keyboard polling and shell dispatch
// This is the main/OS thread. Has highest effective priority
// since background threads are below-normal and low.
// ================================================================
void loop() {
    // TOP BAR: always, regardless of mode
    static uint32_t lastTopBarMs = 0;
    if (millis() - lastTopBarMs >= 1000) { drawTopBar(); lastTopBarMs = millis(); }

    // Route rendering and keyboard by app mode
    if (gOSMode == 1) {
        gbEditorLoop();
        rtos::ThisThread::yield();
        return;
    }
    if (gOSMode == 2) {
        gbRunnerLoop();
        rtos::ThisThread::yield();
        return;
    }

    // MODE_SHELL -- normal GigaOS terminal
    if (termDirty) drawTerminal();

    // Cursor blink: toggle every 500ms, reset to visible on keypress
    if (millis() - gLastCursorToggle >= 500) {
        gCursorVisible = !gCursorVisible;
        gLastCursorToggle = millis();
        drawInputCursorOnly();
    }

    // Keyboard: drain ALL pending events before rendering
    while (keyb.available()) {
        auto     rawKey = keyb.read();
        uint8_t  hid    = rawKey.keys[0];
        char     c      = keyb.getAscii(rawKey);
        uint32_t now    = millis();

        // Debounce
        if (hid == lastHIDKey && (now - lastKeyMs) < 100) continue;
        if (hid != lastHIDKey && (now - lastKeyMs) < 10)  continue;
        lastHIDKey = hid; lastKeyMs = now;

        // Any keypress resets cursor blink to visible
        gCursorVisible = true; gLastCursorToggle = millis();

        // Escape -- cancel interactive modes
        if (hid == 0x29) {
            if (gInputMode != MODE_SHELL) {
                gInputMode = MODE_SHELL; gPassMasked = false;
                inputLen = 0; memset(inputBuf, 0, sizeof(inputBuf));
                termPrint("Cancelled.", COL_DIM); termDirty = true;
            }
            drawInput(); continue;
        }

        // Capslock (shell mode only)
        if (hid == 0x39 && gInputMode == MODE_SHELL) {
            gCapslockOn = !gCapslockOn; drawInput(); continue;
        }

        // Up arrow (0x52) -- history older
        if (hid == 0x52 && gInputMode == MODE_SHELL) {
            if (historyCount > 0) {
                if (historyIdx == -1) { historySaved = String(inputBuf); historyIdx = 0; }
                else if (historyIdx < historyCount - 1) historyIdx++;
                int ap = ((historyPos - 1 - historyIdx) % HISTORY_SIZE + HISTORY_SIZE) % HISTORY_SIZE;
                strncpy(inputBuf, cmdHistory[ap].c_str(), sizeof(inputBuf) - 1);
                inputBuf[sizeof(inputBuf)-1] = '\0';
                inputLen = strlen(inputBuf); drawInput();
            }
            continue;
        }

        // Down arrow (0x51) -- history newer
        if (hid == 0x51 && gInputMode == MODE_SHELL) {
            if (historyIdx != -1) {
                historyIdx--;
                if (historyIdx < 0) {
                    historyIdx = -1;
                    strncpy(inputBuf, historySaved.c_str(), sizeof(inputBuf) - 1);
                } else {
                    int ap = ((historyPos - 1 - historyIdx) % HISTORY_SIZE + HISTORY_SIZE) % HISTORY_SIZE;
                    strncpy(inputBuf, cmdHistory[ap].c_str(), sizeof(inputBuf) - 1);
                }
                inputBuf[sizeof(inputBuf)-1] = '\0';
                inputLen = strlen(inputBuf); drawInput();
            }
            continue;
        }

        // Backspace -- HID first (confirmed getAscii() bug: maps 0x2A to '\r')
        if (hid == 0x2A || hid == 0x4C || c == 8 || c == 127) {
            if (inputLen > 0) { inputBuf[--inputLen] = '\0'; drawInput(); }

        // Enter
        } else if (c == '\r' || c == '\n') {
            if (gInputMode == MODE_WIFI_SSID) {
                if (inputLen == 0) {
                    termPrint("(no SSID -- cancelled)", COL_DIM);
                    gInputMode = MODE_SHELL; gPassMasked = false;
                } else {
                    inputBuf[inputLen] = '\0';
                    strncpy(gWifiSSID, inputBuf, sizeof(gWifiSSID));
                    termPrintf(COL_DIM, "  Network: %s", gWifiSSID);
                    gInputMode = MODE_WIFI_PASS; gPassMasked = true;
                }
                inputLen = 0; memset(inputBuf, 0, sizeof(inputBuf));
                termDirty = true; drawInput();
            } else if (gInputMode == MODE_WIFI_PASS) {
                inputBuf[inputLen] = '\0';
                strncpy(gWifiPass, inputBuf, sizeof(gWifiPass));
                termPrint("  Password: ********", COL_DIM);
                inputLen = 0; memset(inputBuf, 0, sizeof(inputBuf));
                gInputMode = MODE_SHELL; gPassMasked = false;
                gWifiConnecting = true; gWifiConnected = false;
                termPrintf(COL_INFO, "Connecting to [%s]...", gWifiSSID);
                wifiEvt.set(WIFIEVT_CONNECT);
                termDirty = true; drawInput();
            } else if (inputLen > 0) {
                inputBuf[inputLen] = '\0';
                String cmd = String(inputBuf);
                inputLen = 0; memset(inputBuf, 0, sizeof(inputBuf));
                historyIdx = -1; historySaved = "";
                dispatch(cmd);
                termDirty = true; drawInput();
            } else {
                drawInput();
            }

        // Printable
        } else if (c >= 32 && c < 127) {
            int maxInput = TERM_COLS - strlen(currentPrompt());
            if (inputLen < maxInput) {
                char ch = c;
                if (gCapslockOn && gInputMode == MODE_SHELL && isalpha((unsigned char)c))
                    ch = islower((unsigned char)c) ? toupper(c) : tolower(c);
                inputBuf[inputLen++] = ch;
                inputBuf[inputLen]   = '\0';
                drawInput();
            }
        }
        // Left/right arrows + other specials: ignored (future: cursor-in-line movement)
    }

    // Serial input -- poll and dispatch complete lines
    while (Serial.available()) {
        char sc = (char)Serial.read();
        if (!gSerialActive) {
            // First byte ever received -- announce ourselves
            gSerialActive = true;
            Serial.println("\r\nGigaOS v1.0 beta  |  serial console active");
            Serial.println("Type commands and press Enter. 'help' for list.");
            Serial.println("Note: gbasic new/edit require the display; use gbasic run/list/files here.");
            Serial.println("GigaOS> ");
        }
        if (sc == '\r') continue;           // ignore CR, wait for LF
        if (sc == '\n' || sc == '\r') {
            serialBuf[serialBufLen] = '\0';
            String scmd = String(serialBuf);
            serialBufLen = 0;
            memset(serialBuf, 0, sizeof(serialBuf));
            serialDispatch(scmd);
        } else if (sc == 127 || sc == 8) {   // backspace
            if (serialBufLen > 0) { serialBufLen--; Serial.print("\b \b"); }
        } else if (serialBufLen < TERM_LINE_LEN - 1) {
            serialBuf[serialBufLen++] = sc;
            Serial.print(sc);               // local echo
        }
    }

    // Yield to background threads.
    // sleep_for(1) instead of yield() lets the idle thread actually run,
    // which keeps the mbed CPU% stat accurate. Pure yield() busy-loops
    // the main thread and starves idle, making CPU appear 100%.
    rtos::ThisThread::sleep_for(1);
}
