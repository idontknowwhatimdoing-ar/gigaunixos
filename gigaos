// ================================================================
// MATH -- recursive descent expression evaluator
// Supports: + - * / % ^ () unary minus
// ================================================================
struct MathParser {
    const char* s;
    int         pos;
    bool        err;
    char        errAt[32];

    void skip() { while (s[pos]==' '||s[pos]=='\t') pos++; }

    double expr() {
        double v = term(); skip();
        while (s[pos]=='+' || s[pos]=='-') {
            char op=s[pos++]; double r=term();
            v = (op=='+') ? v+r : v-r; skip();
        }
        return v;
    }
    double term() {
        double v = power(); skip();
        while (s[pos]=='*'||s[pos]=='/'||s[pos]=='%') {
            char op=s[pos++]; double r=power();
            if ((op=='/'||op=='%') && r==0.0) { err=true; return 0; }
            if      (op=='*') v*=r;
            else if (op=='/') v/=r;
            else              v=fmod(v,r);
            skip();
        }
        return v;
    }
    double power() {
        double base=unary(); skip();
        if (s[pos]=='^') { pos++; double e=unary(); return pow(base,e); }
        return base;
    }
    double unary() {
        skip();
        if (s[pos]=='-') { pos++; return -unary(); }
        if (s[pos]=='+') { pos++; return  unary(); }
        return primary();
    }
    double primary() {
        skip();
        if (s[pos]=='(') {
            pos++;
            double v=expr(); skip();
            if (s[pos]==')') pos++; else err=true;
            return v;
        }
        if (!isdigit((unsigned char)s[pos]) && s[pos]!='.') {
            err=true;
            snprintf(errAt, sizeof(errAt), "near: %.16s", s+pos);
            return 0;
        }
        char* end;
        double v=strtod(s+pos, &end);
        pos=(int)(end-s);
        return v;
    }
};

void cmd_math(String args) {
    if (args.length() == 0) {
        termPrint("Error: no expression.", COL_ERROR);
        termPrint("       Usage: math <expression>", COL_DIM);
        termPrint("       Ops:   + - * / % ^ ()", COL_DIM);
        termPrint("       e.g.:  math (2 + 3) * 4^2", COL_DIM);
        return;
    }
    MathParser p;
    p.s   = args.c_str();
    p.pos = 0;
    p.err = false;
    p.errAt[0] = '\0';

    double result = p.expr();
    p.skip();

    if (p.err || p.s[p.pos] != '\0') {
        char msg[64];
        snprintf(msg, sizeof(msg), "math: syntax error %s", p.errAt);
        termPrint(msg, COL_ERROR);
        return;
    }

    char buf[48];
    // Show as integer if result is whole and within safe range
    if (result == floor(result) && fabs(result) < 1e15 && !isinf(result))
        snprintf(buf, sizeof(buf), "= %.0f", result);
    else if (isinf(result))
        snprintf(buf, sizeof(buf), "= %s", result > 0 ? "inf" : "-inf");
    else
        snprintf(buf, sizeof(buf), "= %g", result);
    termPrint(buf, COL_INFO);
}

// ================================================================
// PING -- real ICMP ping via mbed ICMPSocket (raw sockets enabled on GIGA M7)
// Runs in pingTask background thread so the shell stays responsive.
// ================================================================
static void pingTaskFn() {
    while (true) {
        pingEvt.wait_any(PINGEVT_START);
        gPingRunning = true;

        NetworkInterface* net = NetworkInterface::get_default_instance();
        if (!net) {
            termPrint("ping: no network interface.", COL_ERROR);
            gPingRunning = false; termDirty = true; continue;
        }

        // DNS resolution
        SocketAddress addr;
        termPrintf(COL_TEXT, "Resolving %s...", gPingHost);
        nsapi_error_t dns = net->gethostbyname(gPingHost, &addr);
        if (dns != NSAPI_ERROR_OK) {
            termPrintf(COL_ERROR, "ping: cannot resolve '%s' (err %d)", gPingHost, dns);
            gPingRunning = false; termDirty = true; continue;
        }

        const char* ipStr = addr.get_ip_address();
        termPrintf(COL_INFO, "PING %s (%s): %d packets", gPingHost, ipStr, gPingCount);

        ICMPSocket icmp;
        if (icmp.open(net) != NSAPI_ERROR_OK) {
            termPrint("ping: failed to open ICMP socket.", COL_ERROR);
            gPingRunning = false; termDirty = true; continue;
        }
        icmp.set_timeout(2000);

        int sent=0, recv=0;
        uint32_t minRtt=UINT32_MAX, maxRtt=0, totalRtt=0;

        for (int seq = 1; seq <= gPingCount; seq++) {
            uint32_t t0 = millis();
            int res = icmp.ping(addr, 2000);   // timeout in ms is mandatory arg
            uint32_t rtt = millis() - t0;
            sent++;

            if (res >= 0) {
                recv++; totalRtt += rtt;
                if (rtt < minRtt) minRtt = rtt;
                if (rtt > maxRtt) maxRtt = rtt;
                termPrintf(COL_TEXT, "64 bytes from %s: icmp_seq=%d ttl=57 time=%lu ms",
                           ipStr, seq, rtt);
            } else if (res == NSAPI_ERROR_TIMEOUT) {
                termPrintf(COL_ERROR, "Request timeout for icmp_seq=%d", seq);
            } else {
                termPrintf(COL_ERROR, "ping: error %d on icmp_seq=%d", res, seq);
            }
            termDirty = true;
            if (seq < gPingCount) rtos::ThisThread::sleep_for(1000);
        }

        icmp.close();

        int loss = (int)(100.0f * (sent - recv) / sent);
        termPrint("", COL_TEXT);
        termPrintf(COL_DIM,  "--- %s ping statistics ---", gPingHost);
        termPrintf(COL_TEXT, "%d packets sent, %d received, %d%% packet loss",
                   sent, recv, loss);
        if (recv > 0 && minRtt != UINT32_MAX)
            termPrintf(COL_TEXT, "rtt min/avg/max = %lu/%lu/%lu ms",
                       minRtt, totalRtt / recv, maxRtt);

        gPingRunning = false;
        termDirty = true;
    }
}

void cmd_ping(String args) {
    if (!gWifiConnected) {
        termPrint("ping: not connected to WiFi.", COL_ERROR);
        termPrint("      Use 'wifi connect SSID PASS' first.", COL_DIM);
        return;
    }
    if (gPingRunning) {
        termPrint("ping: already running. Wait for it to finish.", COL_ERROR);
        return;
    }

    args.trim();
    String host;
    int count = -1;  // -1 = not specified

    // Parse: ping <host> [-c N]  or  ping [-c N] <host>
    int cIdx = args.indexOf("-c");
    if (cIdx != -1) {
        String afterC = args.substring(cIdx + 2); afterC.trim();
        int sp = afterC.indexOf(' ');
        String countStr = (sp == -1) ? afterC : afterC.substring(0, sp);
        count = countStr.toInt();
        if (count <= 0) {
            termPrint("Error: -c requires a positive integer.", COL_ERROR);
            return;
        }
        if (count > 500) count = 500;
        // Host is whatever is NOT the -c section
        host = args.substring(0, cIdx);
        host.trim();
        if (host.length() == 0 && sp != -1) {
            host = afterC.substring(sp + 1); host.trim();
        }
    } else {
        host = args;
        count = 100;  // no -c = send 100 (infinite-ish; Ctrl+C not implemented yet)
    }

    if (host.length() == 0) {
        termPrint("Error: missing hostname or IP address.", COL_ERROR);
        termPrint("       Usage: ping <host> [-c count]", COL_DIM);
        termPrint("       e.g.:  ping 1.1.1.1 -c 4", COL_DIM);
        termPrint("       e.g.:  ping google.com", COL_DIM);
        return;
    }

    host.toCharArray(gPingHost, sizeof(gPingHost));
    gPingCount = count;

    if (count == 100 && cIdx == -1)
        termPrint("(no -c given -- sending 100 packets)", COL_DIM);

    pingEvt.set(PINGEVT_START);
}

