// -- help utilities ---------------------------------------------
// Wrap and print a string with a fixed left-padding indent.
// Returns number of lines printed.
static int helpPrintWrapped(const char* prefix, const char* text, uint16_t color) {
    int prefLen  = strlen(prefix);
    int maxW     = TERM_COLS - prefLen - 1;
    if (maxW < 8) maxW = 8;
    char indent[TERM_LINE_LEN]; memset(indent, ' ', prefLen); indent[prefLen] = '\0';
    char buf[TERM_LINE_LEN];
    int pos = 0, len = strlen(text), lines = 0;
    while (pos < len) {
        int remaining = len - pos;
        int brk = (remaining <= maxW) ? remaining : maxW;
        if (remaining > maxW) {
            // find last space within window
            for (int i = brk; i > 0; i--) {
                if (text[pos + i] == ' ') { brk = i; break; }
            }
        }
        if (lines == 0)
            snprintf(buf, sizeof(buf), "%s%.*s", prefix, brk, text + pos);
        else
            snprintf(buf, sizeof(buf), "%s%.*s", indent, brk, text + pos);
        termPrint(buf, color);
        lines++;
        pos += brk;
        if (pos < len && text[pos] == ' ') pos++; // skip the space we broke on
    }
    if (lines == 0) { termPrint(prefix, color); lines = 1; }
    return lines;
}

void cmd_help(String args) {
    args.trim();

    // -- help <command> -- specific command detail -----------------
    if (args.length() > 0 && !isdigit((unsigned char)args[0])) {
        args.toLowerCase();
        for (int i = 0; i < CMD_COUNT; i++) {
            if (args.equals(commands[i].name)) {
                termPrint("", COL_TEXT);
                char hdr[TERM_LINE_LEN];
                snprintf(hdr, sizeof(hdr), "  %s", commands[i].name);
                termPrint(hdr, COL_INFO);
                helpPrintWrapped("  Usage:  ", commands[i].usage,       COL_DIM);
                helpPrintWrapped("  About:  ", commands[i].description,  COL_TEXT);
                termPrint("", COL_TEXT);
                return;
            }
        }
        termPrintf(COL_ERROR, "Unknown command: %s", args.c_str());
        termPrint("  Type 'help' to list all commands.", COL_DIM);
        return;
    }

    // -- help [N] -- paginated listing -----------------------------
    // Each entry = 1 line for name + description (possibly wrapped).
    // Pre-compute line counts so pagination is exact.
    const int NAME_W    = 12;       // "  name      " column
    const int DESC_W    = TERM_COLS - NAME_W - 1;
    const int HDR_LINES = 3;        // header + separator
    const int FTR_LINES = 2;        // separator + footer tip
    const int PAGE_H    = TERM_ROWS_VIS - HDR_LINES - FTR_LINES;

    // Count lines per command
    int lineCounts[64] = {};
    for (int i = 0; i < CMD_COUNT && i < 64; i++) {
        int dlen = strlen(commands[i].description);
        lineCounts[i] = 1 + (dlen > DESC_W ? (dlen - 1) / DESC_W : 0);
    }

    // Assign commands to pages
    int pageStarts[16] = {0}; int pageCount = 1;
    int lineAcc = 0;
    for (int i = 0; i < CMD_COUNT; i++) {
        if (lineAcc + lineCounts[i] > PAGE_H && lineAcc > 0) {
            if (pageCount < 16) pageStarts[pageCount++] = i;
            lineAcc = 0;
        }
        lineAcc += lineCounts[i];
    }

    int page = 1;
    if (args.length() > 0) page = args.toInt();
    if (page < 1) page = 1;
    if (page > pageCount) page = pageCount;

    int startCmd = pageStarts[page - 1];
    int endCmd   = (page < pageCount) ? pageStarts[page] : CMD_COUNT;

    // Header
    char hdr[TERM_LINE_LEN];
    snprintf(hdr, sizeof(hdr), "  GigaOS commands -- page %d of %d", page, pageCount);
    termPrint(hdr, COL_INFO);
    termPrint("  --------------------------------------------------------------", COL_DIM);
    termPrint("", COL_TEXT);

    // Entries
    for (int i = startCmd; i < endCmd; i++) {
        char nameCol[NAME_W + 1];
        snprintf(nameCol, sizeof(nameCol), "  %-*s", NAME_W - 2, commands[i].name);
        helpPrintWrapped(nameCol, commands[i].description, COL_TEXT);
    }

    // Footer
    termPrint("", COL_TEXT);
    termPrint("  --------------------------------------------------------------", COL_DIM);
    char ftr[TERM_LINE_LEN];
    if (pageCount > 1)
        snprintf(ftr, sizeof(ftr), "  'help <N>' for page N  |  'help <cmd>' for details  |  page %d/%d", page, pageCount);
    else
        snprintf(ftr, sizeof(ftr), "  'help <command>' for usage and details");
    termPrint(ftr, COL_DIM);
}

void cmd_rtc(String args) {
    // rtc / rtc show -- full date + time
    if (args.length() == 0 || args.startsWith("show")) {
        termPrint(rtcDateTime(), COL_INFO);
        if (!gNtpSynced)
            termPrint("  (not NTP synced -- run 'rtc sync' when on WiFi)", COL_DIM);
        return;
    }

    // rtc time -- time only
    if (args.startsWith("time")) {
        termPrint(rtcTime(), COL_INFO);
        return;
    }

    // rtc date -- date only
    if (args.startsWith("date")) {
        char buf[16]; tm t;
        _rtc_localtime(time(NULL), &t, RTC_4_YEAR_LEAP_YEAR_SUPPORT);
        strftime(buf, sizeof(buf), "%Y-%m-%d", &t);
        termPrint(String(buf), COL_INFO);
        return;
    }

    // rtc sync
    if (args.startsWith("sync")) {
        if (!gWifiConnected) {
            termPrint("Error: not connected to WiFi.", COL_ERROR);
            termPrint("       Use 'wifi connect SSID PASS' first.", COL_DIM);
            return;
        }
        termPrint("Syncing via NTP...", COL_INFO);
        if (ntpSync())
            termPrint("Synced: " + rtcDateTime(), COL_INFO);
        else
            termPrint("NTP sync failed.", COL_ERROR);
        return;
    }

    // rtc set HH:MM:SS DD/MM/YYYY
    if (args.startsWith("set ")) {
        String p = args.substring(4);
        p.trim();
        int si = p.indexOf(' ');
        if (si == -1) {
            termPrint("Error: missing date argument.", COL_ERROR);
            termPrint("       Usage:   rtc set HH:MM:SS DD/MM/YYYY", COL_DIM);
            termPrint("       Example: rtc set 14:30:00 28/05/2026", COL_DIM);
            return;
        }
        String ts = p.substring(0, si);
        String ds = p.substring(si + 1);
        int h, mi, s, d, mo, y;
        if (sscanf(ts.c_str(), "%d:%d:%d", &h, &mi, &s) != 3 ||
            sscanf(ds.c_str(), "%d/%d/%d", &d, &mo, &y) != 3) {
            termPrint("Error: could not parse time or date.", COL_ERROR);
            termPrint("       Expected format: HH:MM:SS DD/MM/YYYY", COL_DIM);
            return;
        }
        if (h  < 0 || h  > 23)   { termPrint("Error: hour must be 0-23.",    COL_ERROR); return; }
        if (mi < 0 || mi > 59)   { termPrint("Error: minute must be 0-59.",  COL_ERROR); return; }
        if (s  < 0 || s  > 59)   { termPrint("Error: second must be 0-59.",  COL_ERROR); return; }
        if (d  < 1 || d  > 31)   { termPrint("Error: day must be 1-31.",     COL_ERROR); return; }
        if (mo < 1 || mo > 12)   { termPrint("Error: month must be 1-12.",   COL_ERROR); return; }
        if (y  < 2000 || y > 2100) { termPrint("Error: year must be 2000-2100.", COL_ERROR); return; }

        tm t     = {};
        t.tm_hour = h;  t.tm_min  = mi; t.tm_sec  = s;
        t.tm_mday = d;  t.tm_mon  = mo - 1; t.tm_year = y - 1900;
        set_time(mktime(&t));
        gNtpSynced = false;
        termPrint("Time set: " + rtcDateTime(), COL_INFO);
        return;
    }

    termPrint("Error: unknown subcommand.", COL_ERROR);
    termPrint("       Usage: rtc [show | time | date | set HH:MM:SS DD/MM/YYYY | sync]", COL_DIM);
}

