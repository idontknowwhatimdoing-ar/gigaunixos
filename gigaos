// ================================================================
// HELPERS -- CPU die temperature
// STM32H7 factory cal values burned into flash at production.
// Reads ADC3 ch18 (internal sensor) and interpolates.
// Note: reads die temp (not air); expect 45-60F above ambient at load.
// ================================================================
#define TS_CAL1  (*(volatile uint16_t*)0x1FF1E820UL)  // cal at 30C
#define TS_CAL2  (*(volatile uint16_t*)0x1FF1E840UL)  // cal at 110C


// I  | II
// --------
// II | I_
// i loss my code


static float readTempF() {
    // STM32H747 internal temperature sensor.
    // Returns degrees F, or -1.0f if unavailable (shown as "---" in UI).
    //
    // The factory calibration values are burned into system flash:
    //   TS_CAL1 @ 0x1FF1E820 = raw ADC count at 30C (3.3V)
    //   TS_CAL2 @ 0x1FF1E840 = raw ADC count at 110C (3.3V)
    uint16_t cal1 = TS_CAL1, cal2 = TS_CAL2;
    if (!cal1 || !cal2 || cal1 >= cal2 ||
        cal1 == 0xFFFF || cal2 == 0xFFFF)
        return -1.0f;   // cal data missing or corrupted

    float raw = -1.0f;

    // Attempt 1: ATEMP pin (defined in some ArduinoCore-mbed versions)
#ifdef ATEMP
    analogReadResolution(16);
    raw = (float)analogRead(ATEMP);
#endif

    // Attempt 2: ADC_TEMP (mbed PinName for internal temp channel on STM32H7)
#if !defined(ATEMP) && defined(ADC_TEMP)
    {
        static mbed::AnalogIn* tSense = nullptr;
        if (!tSense) tSense = new mbed::AnalogIn(ADC_TEMP);
        if (tSense)  raw = tSense->read() * 65535.0f;
    }
#endif

    // Attempt 3: PADC_TEMP (alternate name used in some STM32 cores)
#if !defined(ATEMP) && !defined(ADC_TEMP) && defined(PADC_TEMP)
    analogReadResolution(16);
    raw = (float)analogRead(PADC_TEMP);
#endif

    if (raw < 0.0f) return -1.0f;  // nothing worked

    float degC = (80.0f / (float)(cal2 - cal1)) * (raw - (float)cal1) + 30.0f;
    return degC * 9.0f / 5.0f + 32.0f;
}

