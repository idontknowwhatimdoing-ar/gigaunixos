// ================================================================
// SHELL -- parse and dispatch a command string
// ================================================================
// ================================================================
// SERIAL DISPATCH
// Runs a command received over Serial. Mirrors output back via Serial.
// Blocks UI-only commands (gbasic new / gbasic edit).
// ================================================================
static bool gFromSerial = false;

static const char* serialBlacklist[] = {
    "gbasic new", "gbasic edit", nullptr
};

static void serialDispatch(String raw) {
    raw.trim();
    if (raw.length() == 0) {
        Serial.println("GigaOS> ");
        return;
    }
    // Check blacklist -- these need the display + keyboard, can't work over serial
    for (int i = 0; serialBlacklist[i]; i++) {
        if (raw.startsWith(serialBlacklist[i])) {
            Serial.println("Error: '" + String(serialBlacklist[i]) + "' requires the display and keyboard.");
            Serial.println("  Tip: use 'gbasic run', 'gbasic list', 'gbasic files' etc. from serial.");
            Serial.println("GigaOS> ");
            return;
        }
    }
    gFromSerial = true;
    dispatch(raw);
    gFromSerial = false;
    Serial.println("GigaOS> ");
}

static void dispatch(String raw) {
    raw.trim();
    if (raw.length() == 0) return;

    // Record in history (skip consecutive duplicates)
    int prevPos = (historyPos - 1 + HISTORY_SIZE) % HISTORY_SIZE;
    if (historyCount == 0 || cmdHistory[prevPos] != raw) {
        cmdHistory[historyPos] = raw;
        historyPos = (historyPos + 1) % HISTORY_SIZE;
        if (historyCount < HISTORY_SIZE) historyCount++;
    }

    // Echo to terminal
    termPrintf(COL_PROMPT, "%s%s", currentPrompt(), raw.c_str());

    // Split: first word = command, rest = args
    int    sp = raw.indexOf(' ');
    String cn = (sp == -1) ? raw             : raw.substring(0, sp);
    String ar = (sp == -1) ? String("")      : raw.substring(sp + 1);
    cn.trim();
    cn.toLowerCase();
    ar.trim();

    // Look up command
    for (int i = 0; i < CMD_COUNT; i++) {
        if (cn.equals(commands[i].name)) {
            commands[i].fn(ar);
            return;
        }
    }

    // Not found -- fuzzy match
    const char* suggestion = closestCmd(cn.c_str());
    if (suggestion) {
        termPrintf(COL_ERROR,
                   "[%s] is an unknown command, did you mean [%s]?",
                   cn.c_str(), suggestion);
    } else {
        termPrintf(COL_ERROR,
                   "[%s] is an unknown command. Type 'help' for a list.",
                   cn.c_str());
    }
}

