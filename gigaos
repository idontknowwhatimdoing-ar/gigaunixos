void cmd_mem(String args) {
    mbed_stats_heap_t heap;
    mbed_stats_heap_get(&heap);

    termPrint("-- Memory Usage -------------------------", COL_INFO);
    if (heap.reserved_size > 0) {
        uint32_t freeHeap = heap.reserved_size - heap.current_size;
        uint8_t  pct      = (uint8_t)((heap.current_size * 100UL) / heap.reserved_size);
        termPrintf(COL_TEXT, "  Heap used:    %6lu B  (%lu KB)", heap.current_size,  heap.current_size  / 1024);
        termPrintf(COL_TEXT, "  Heap free:    %6lu B  (%lu KB)", freeHeap,            freeHeap           / 1024);
        termPrintf(COL_TEXT, "  Heap total:   %6lu B  (%lu KB)", heap.reserved_size,  heap.reserved_size / 1024);
        termPrintf(COL_TEXT, "  Heap peak:    %6lu B  (%lu KB)", heap.max_size,        heap.max_size      / 1024);
        termPrintf(COL_TEXT, "  Usage:        %u%%", pct);
        termPrintf(COL_DIM,  "  Allocs:       %lu ok,  %lu failed",
                   heap.alloc_cnt, heap.alloc_fail_cnt);
